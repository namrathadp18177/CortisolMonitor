<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.jjoe64.graphview" />

    <uses-permission android:name="android.permission.BLUETOOTH" /> <!-- Required permissions for Kommunicate -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- USB Permissions -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />



    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.Light"
        android:hardwareAccelerated="true"
        tools:targetApi="31">
    <activity
            android:name=".FinalResultsActivity"
            android:exported="false" />
        <activity
            android:name=".QuestionnaireResultsActivity"
            android:exported="false" />
        <activity
            android:name=".ChatbotActivity"
            android:exported="false" />
        <activity
            android:name=".IntegratedResultsActivity"
            android:exported="false" />
        <activity
            android:name=".CombinedResultsActivity"
            android:exported="false" />
        <activity
            android:name=".QuestionnaireMain"
            android:exported="false" />

        <!-- Not exported: every caller in this app launches it via an explicit Intent
             (see HomeFragment, EditPatientActivity, ModifyPatientActivity,
             QuestionnaireResultsActivity, RegisterPatientActivity — none rely on an
             implicit-intent / deep-link entry point). It previously had an unrestricted
             exported ACTION_VIEW filter, which let any app on the device launch it directly
             with an arbitrary user_role/user_email, bypassing login and attributing a
             biomarker test to any patient email of the caller's choosing. -->
        <activity
            android:name=".BiomarkerInstructions"
            android:exported="false" />

        <activity
            android:name=".BiomarkerActivty"
            android:exported="false" />
        <activity
            android:name=".WebViewActivity"
            android:exported="false" />


        <activity android:name=".CareProviderDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterPatientActivity"
            android:exported="false" />
        <activity
            android:name=".ModifyPatientActivity"
            android:exported="false" />

        <activity
            android:name=".ViewHistoryActivity"
            android:exported="false" />
        <activity android:name=".AccountDetailsActivity" />
        <activity android:name=".CareProviderInfoActivity" android:exported="false" />
        <activity android:name=".ResultDetailActivity" android:exported="false" />
        <activity android:name=".CareProviderAccountActivity" />
        <activity android:name=".ActivateAccountActivity" />
        <activity android:name=".PatientHistoryDetailActivity" />
        <activity android:name=".DeveloperModeActivity" />
        <activity
            android:name=".QRScanActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".CortisolGraphActivity"
            android:label="Cortisol Graph"
            android:parentActivityName=".PatientMainActivity" />
        <activity
            android:name=".PatientMainActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Light" />
        <activity
            android:name=".QRWizardActivity"
            android:exported="false" />
        <activity android:name=".PatientResultsActivity" />

        <activity
            android:name=".QuestionnaireActivity2"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".OutputBluetooth"
            android:exported="false" />

        <activity
            android:name=".StepsActivity"
            android:exported="false" />
        <activity
            android:name=".BluetoothListActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Light" />
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Light"
            android:hardwareAccelerated="true" />
        <activity
            android:name=".QuestionnaireActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Light" />
        <activity
            android:name=".RegisterLoginActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Light"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ResponsesViewerActivity"
            android:exported="false" />
        <activity
            android:name=".SessionDetailActivity"
            android:exported="false" />
        <activity
            android:name=".HealthLogActivity"
            android:exported="false" />
        <activity
            android:name=".HealthCardLogActivity"
            android:exported="false" />
        <!-- FileProvider for sharing files -->


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receives HRV (heart rate + IBI) / EDA / skin-temp batches pushed from the
             Wear OS watch module (:myapplication) over the Data Layer MessageClient. -->
        <service
            android:name=".WatchDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/vitals" />
            </intent-filter>
        </service>

        <service
            android:name=".VitalsIngestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".LiveVitalsActivity"
            android:exported="false"
            android:label="Live Watch Vitals" />

        <activity
            android:name=".VitalsSessionHistoryActivity"
            android:exported="false"
            android:label="Watch Session History" />

        <activity
            android:name=".VitalsSessionDetailActivity"
            android:exported="false" />

        <!-- Day-wise history + graph for one vital (heart rate/HRV, EDA, skin temperature),
             reached by tapping the corresponding card on LiveVitalsActivity. -->
        <activity
            android:name=".VitalsDayListActivity"
            android:exported="false" />

        <activity
            android:name=".VitalsDayDetailActivity"
            android:exported="false" />

    </application>

</manifest>