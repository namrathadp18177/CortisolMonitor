<?xml version="1.0" encoding="utf-8"?><!--
   Legacy Auto Backup rules for devices below API 31 (data_extraction_rules.xml covers
   API 31+). Same exclusions — these files hold plaintext passwords, mental-health
   screener responses, and biomarker/cortisol results and must never be backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="AppData.db" />
    <exclude domain="database" path="UserProfile.db" />
    <exclude domain="database" path="watch_vitals.db" />
    <exclude domain="sharedpref" path="user_prefs.xml" />
    <exclude domain="sharedpref" path="cortisol_prefs.xml" />
    <exclude domain="sharedpref" path="BiomarkerResults.xml" />
    <exclude domain="sharedpref" path="AssessmentResults.xml" />
    <exclude domain="sharedpref" path="IntegratedResults.xml" />
    <exclude domain="sharedpref" path="SessionStressResults.xml" />
    <exclude domain="sharedpref" path="SessionScoreDetails.xml" />
    <exclude domain="sharedpref" path="session.xml" />
</full-backup-content>
