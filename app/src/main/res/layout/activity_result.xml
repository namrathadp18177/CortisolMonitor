<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_background"
        android:elevation="0dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Results"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </androidx.appcompat.widget.Toolbar>

    <!-- SCROLLVIEW FOR CONTENT -->
    <ScrollView
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Root for PDF export -->
        <LinearLayout
            android:id="@+id/resultRootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Result Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Reading"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvCortisol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cortisol: -- ng/mL"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Measured on: --"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />

                    <!-- Stats chips row: Peak + Lowest only -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/tvPeakCortisol"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Peak: --"
                            android:textSize="14sp"
                            android:padding="8dp"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="#FFF3E0"
                            android:textColor="@color/stress_moderate" />

                        <TextView
                            android:id="@+id/tvMinCortisol"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lowest: --"
                            android:textSize="14sp"
                            android:padding="8dp"
                            android:gravity="center"
                            android:layout_marginStart="4dp"
                            android:background="@color/divider_color"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Previous Test Results Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Previous Test Results"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvPreviousResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No previous results available."
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!--  TABLE WITH FIXED HEIGHT - NO NESTED SCROLL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/background"
                android:padding="8dp"
                android:orientation="vertical">

                <TableLayout
                    android:id="@+id/tablePreviousResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0,1">

                    <!-- Header Row -->
                    <TableRow
                        android:background="@color/primary_surface"
                        android:padding="8dp">

                        <TextView
                            android:text="Time"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:textSize="14sp"
                            android:textColor="@color/primary" />

                        <TextView
                            android:text="Cortisol(ng/mL)"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:gravity="end"
                            android:textSize="14sp"
                            android:textColor="@color/primary" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>

            <!-- Graph Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's Pattern"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/text_primary" />

            <com.jjoe64.graphview.GraphView
                android:id="@+id/graphViewResults"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/background"
                android:elevation="2dp" />

            <!-- Export buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCsv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export All Data to CSV"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export All Data to PDF"
                    android:textColor="@color/text_primary"
                    android:background="@color/primary"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:elevation="2dp" />
            </LinearLayout>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBiomarker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to Dashboard"
                android:textColor="@color/text_primary"
                android:background="@color/toolbar_background"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
