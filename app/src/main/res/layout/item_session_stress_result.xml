<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="8dp">

    <!-- Divider line above the result card -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp" />

    <!-- Result card -->
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/resultCardBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- "ASSESSMENT RESULT" label -->
            <TextView
                android:id="@+id/tvResultLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSESSMENT RESULT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#CCFFFFFF"
                android:letterSpacing="0.1" />

            <!-- Level name -->
            <TextView
                android:id="@+id/tvResultLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <!-- Score breakdown (e.g. "Screener: 28  •  PHQ-9: 15") -->
            <TextView
                android:id="@+id/tvScoreDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="#DDFFFFFF"
                android:visibility="gone" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Based on your responses in this session"
                android:textSize="12sp"
                android:textColor="#DDFFFFFF" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
