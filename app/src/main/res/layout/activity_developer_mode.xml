<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/devToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        app:titleTextColor="@color/white" />

    <LinearLayout
        android:id="@+id/devButtonPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devToolbar"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/devSettingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/colorTextSecondary"
            android:text="SETTINGS"
            android:textColor="@color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/devInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devButtonPanel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="Developer Mode — Live Optical Signal"
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/devInfoText"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.jjoe64.graphview.GraphView
            android:id="@+id/graphViewDev"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="40dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp" />

    </androidx.cardview.widget.CardView>

</RelativeLayout>
