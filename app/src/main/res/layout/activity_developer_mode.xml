<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/devToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_background"
        android:elevation="0dp"
        app:titleTextColor="@color/text_primary"
        app:logoDescription="Cortisol Monitor"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout
        android:id="@+id/devButtonPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devToolbar"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/devSettingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/primary"
            android:text="Settings"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- LED Brightness and Gain controls for BLE hardware -->
    <LinearLayout
        android:id="@+id/devControlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devButtonPanel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!-- LED Brightness row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LED:"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                android:minWidth="36dp" />

            <SeekBar
                android:id="@+id/devLedSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="200" />

            <TextView
                android:id="@+id/devLedValueText"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="200"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:gravity="end"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Gain row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gain:"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                android:minWidth="36dp" />

            <SeekBar
                android:id="@+id/devGainSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="128" />

            <TextView
                android:id="@+id/devGainValueText"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="128"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:gravity="end"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Battery Level row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery:"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                android:minWidth="52dp" />

            <TextView
                android:id="@+id/devBatteryLevelCtrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Battery Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status:"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                android:minWidth="52dp" />

            <TextView
                android:id="@+id/devBatteryStatusCtrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inactive"
                android:textSize="13sp"
                android:textColor="#B00020"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Device status strip -->
    <LinearLayout
        android:id="@+id/devStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devControlsPanel"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/background">

        <!-- Connection status -->
        <TextView
            android:id="@+id/devConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Disconnected"
            android:textSize="12sp"
            android:textColor="#B00020"
            android:textStyle="bold" />

        <!-- Battery level -->
        <TextView
            android:id="@+id/devBatteryLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: —"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/devInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/devStatusPanel"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="Developer Mode — Live Optical Signal"
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/devInfoText"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <com.jjoe64.graphview.GraphView
            android:id="@+id/graphViewDev"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="40dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp" />

    </androidx.cardview.widget.CardView>

</RelativeLayout>
