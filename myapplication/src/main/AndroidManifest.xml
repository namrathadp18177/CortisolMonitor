<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Samsung Health Sensor SDK: EDA / heart-rate+IBI / skin-temperature trackers.
         targetSdk is 34, so BODY_SENSORS is the permission all three trackers need
         (see Watch8_Data_Collection_Guide.md §B2). READ_ADDITIONAL_HEALTH_DATA is
         included too since Samsung's own manifest boilerplate declares both. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="com.samsung.android.hardware.sensormanager.permission.READ_ADDITIONAL_HEALTH_DATA" />

    <!-- ACCELEROMETER_CONTINUOUS needs this even at target API 34 (see Watch8_Data_Collection_Guide.md §B2) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Foreground service so tracking survives the screen turning off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask="false": without this, Android's default behavior kills this
             foreground service the moment its launching task is removed (e.g. exiting/
             swiping away the watch screen), even though it has no other tie to any Activity's
             lifecycle; recording should only ever stop on an explicit "stop" control command
             from the phone (see VitalsControlListenerService), not from the screen closing. -->
        <service
            android:name=".VitalsStreamingService"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="false" />

        <!-- Lets the phone remotely start/stop VitalsStreamingService over the Data Layer,
             so recording can be controlled from the phone's Live Vitals screen. -->
        <service
            android:name=".VitalsControlListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/vitals_control" />
            </intent-filter>
        </service>
    </application>

</manifest>