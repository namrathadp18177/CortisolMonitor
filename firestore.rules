rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // All study data lives under users/{uid}/... and is only readable/writable
    // by that authenticated user. Care-provider access to another person's cloud
    // records is not granted here — providers use the local caseload on the
    // clinic device until a dedicated sharing model exists.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
